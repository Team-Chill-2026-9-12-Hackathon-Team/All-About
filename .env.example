# Server-only configuration. Keep real credentials in .env.
OPENAI_API_KEY=
OPENAI_MODEL=
STEEL_API_KEY=
REDDIT_USER_AGENT=AllAboutCampus/0.1 (read-only RSS; contact: allabout-campus@users.noreply.github.com)
HOST=127.0.0.1
PORT=3001

# Generate with: openssl rand -base64 32
# Local demo also writes .data/credential-vault.key if this is empty.
CREDENTIAL_VAULT_KEY=
# Optional; defaults to .data/credential-vault.json
CREDENTIAL_VAULT_PATH=
