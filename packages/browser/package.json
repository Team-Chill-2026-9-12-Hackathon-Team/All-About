{
  "dependencies": {
    "@types/node": "22.20.2",
    "playwright": "1.63.0",
    "steel-sdk": "0.18.0",
    "typescript": "7.0.2"
  },
  "name": "@allabout/browser",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types src/smoke.ts",
